# Launch the ingest within the container to avoid interrupting the operation
# if disconnected from the machine.

IMAGE=ghcr.io/lsst/qserv-xrd-build-rubinqsv:2026.7.1-rc1-3-g375972aab
CONTAINER=qserv-ingest

docker run --init --rm -it -d \
  -u rubinqsv \
  --mount src=/zfspool/management/qserv,dst=/home/rubinqsv/code/qserv,type=bind \
  --cap-add sys_admin --cap-add sys_ptrace --security-opt seccomp=unconfined \
  -w /home/rubinqsv/code/qserv/build \
  -v /zfspool/data/qserv-usdf-dp2/:/zfspool/data/qserv-usdf-dp2/ \
  --name=${CONTAINER} \
  ${IMAGE} \
  /bin/bash

docker exec -it ${CONTAINER} bash

cd /zfspool/data/qserv-usdf-dp2/ingest/final/qserv-test


# Fix the MySQL grants at workers to work around a bug in the implementation
# of the Replication/Ingest system:

cd /zfspool/management/qserv-slac/instance/slac6test
for host in $(cat config/workers); do
  echo $host;
  ssh $host "mysql -h127.0.0.1 -P3368 -uroot -p***** mysql -e 'GRANT ALL PRIVILEGES ON dp2.* TO  qsmaster@127.0.0.1; FLUSH PRIVILEGES'";
done

cd /zfspool/management/qserv-slac/instance/slac6test
for host in $(cat config/workers); do
  echo $host;
  ssh $host "mysql -h127.0.0.1 -P3368 -uroot -p***** mysql"
done
cd -
